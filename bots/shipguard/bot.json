{
  "$schema": "../../schema/bot.schema.json",
  "slug": "shipguard",
  "name": "ShipGuard",
  "description": "Read-only merge reviewer: one verdict with cited evidence. Edits nothing.",
  "category": "Code review",
  "about": "Point it at any Git repo with a branch that has changes. It compares the branch to your default branch, traces risky changes through the code, and gives one merge verdict with file and line evidence. It reads only: it never edits files, runs your code or touches the network.",
  "features": [
    "Trace auth, money and data risks",
    "Prove every finding with file:line evidence",
    "Flag unused code the branch adds"
  ],
  "examplePrompt": "Review my current branch against main and tell me whether it is safe to merge.",
  "author": {
    "github": "SomeshTalligeriDEV",
    "name": "Smxh_Sol"
  },
